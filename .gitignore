# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
probing.egg-info/
*.egg-info/
*.so
*.bak
.idea/
app/dist/
dist/
.python-version
report.json
pkg/
*/scripts/*
.VSCodeCounter/
*.pyc
venv/
python/probing/probing
.claude/
*.pth.tar
docs/site/
.venv/
.coverage

# Fail-Slow 昇腾：对照原始大 dump 不入库（对外瘦身在 probing-test）
results/ascend-ais/_prep/
results/ascend-ais/baseline/**/ascend_trace*
results/ascend-ais/baseline/**/collect_*.bin
results/ascend-ais/baseline/**/*.so

# Greyhound/XPU 原始采集大文件（对照只入库 VERDICT/SUMMARY/manifest/日志）
results/ascend-ais/baseline/**/hcclprobe.collect*
results/ascend-ais/baseline/**/ascend_trace*
results/ascend-ais/pillar_c/

# Pillar C v2：全量 probing_data / memc 不入库（备份在 ais + AFS）
results/ascend-ais/pillar_c_v2/**/probing_data/
results/ascend-ais/pillar_c_v2/**/*.memc
results/ascend-ais/pillar_c_v2/**/python.variables
results/ascend-ais/pillar_c_v2/**/python.trace_event
results/ascend-ais/pillar_c_v2/**/*.tar

# Param-Calib：大 dump / 中转 tar 不入库（瘦身 PARAM 入库；全量在 AFS + myportal/_backup）
results/ascend-ais/param_calib/**/probing_data/
results/ascend-ais/param_calib/**/*.memc
results/ascend-ais/param_calib/**/python.variables
results/ascend-ais/param_calib/**/python.trace_event
results/ascend-ais/param_calib/**/.pull.tar
results/ascend-ais/param_calib/**/*.tar
results/ascend-ais/param_calib/**/*.tar.gz
results/ascend-ais/param_calib/**/_work/
results/ascend-ais/param_calib/**/by_pod/
